+    private void shareTextContent(String text) {
+        try {
+            Intent intent = new Intent(Intent.ACTION_SEND);
+            intent.setType("text/plain");
+            intent.putExtra(Intent.EXTRA_TEXT, text == null ? "" : text);
+            startActivity(Intent.createChooser(intent, "공유"));
+        } catch (Exception e) {
+            Toast.makeText(this, "공유할 앱을 열지 못했어요.", Toast.LENGTH_SHORT).show();
+        }
+    }
+
+    private void shareImageContent(String filenamePrefix, String dataUrlsJson) {
+        try {
+            org.json.JSONArray array = new org.json.JSONArray(dataUrlsJson);
+            if (array.length() == 0) throw new IllegalArgumentException("No images");
+
+            File sharedDir = new File(getCacheDir(), "shared");
+            if (!sharedDir.exists() && !sharedDir.mkdirs()) {
+                throw new IllegalStateException("Could not create share cache");
+            }
+
+            File[] oldFiles = sharedDir.listFiles();
+            if (oldFiles != null) {
+                for (File old : oldFiles) {
+                    try { old.delete(); } catch (Exception ignored) {}
+                }
+            }
+
+            ArrayList<Uri> uris = new ArrayList<>();
+            for (int i = 0; i < array.length(); i++) {
+                String dataUrl = array.getString(i);
+                int comma = dataUrl.indexOf(',');
+                if (comma < 0) continue;
+                byte[] bytes = Base64.decode(dataUrl.substring(comma + 1), Base64.DEFAULT);
+                String safePrefix = (filenamePrefix == null || filenamePrefix.trim().isEmpty()) ? "unnie" : filenamePrefix.replaceAll("[^A-Za-z0-9._-]", "-");
+                File file = new File(sharedDir, safePrefix + "-" + String.format(Locale.US, "%02d", i + 1) + ".jpg");
+                try (FileOutputStream out = new FileOutputStream(file)) {
+                    out.write(bytes);
+                }
+                Uri uri = FileProvider.getUriForFile(this, getPackageName() + ".fileprovider", file);
+                uris.add(uri);
+            }
+
+            if (uris.isEmpty()) throw new IllegalArgumentException("No shareable images");
+
+            Intent intent;
+            if (uris.size() == 1) {
+                intent = new Intent(Intent.ACTION_SEND);
+                intent.putExtra(Intent.EXTRA_STREAM, uris.get(0));
+            } else {
+                intent = new Intent(Intent.ACTION_SEND_MULTIPLE);
+                intent.putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris);
+            }
+            intent.setType("image/jpeg");
+            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            startActivity(Intent.createChooser(intent, "공유"));
+        } catch (Exception e) {
+            Toast.makeText(this, "이미지를 공유하지 못했어요.", Toast.LENGTH_SHORT).show();
+        }
+    }
